# 必填：Windy Webcams API key，申请地址 https://api.windy.com/keys
WINDY_API_KEY=

# 可选：show 工具把截图传到一个公开 GitHub 仓库，返回 jsDelivr 图片链接
# fine-grained token，只选这一个仓库，Contents 读写
GH_TOKEN=
GH_REPO=yourname/your-snaps

# 可选：Movebank 动物追踪。用户名和密码都要 base64 编码：printf %s '你的用户名' | base64
MOVEBANK_USER_B64=
MOVEBANK_PASS_B64=

# 可选：监听地址，默认 0.0.0.0:8787
HOST=0.0.0.0
PORT=8787


# HTTP 必填；本地 TRANSPORT=stdio 不需要这些 OAuth 配置
TRANSPORT=streamable-http
MCP_RESOURCE_URL=https://your-service.onrender.com/mcp
# Scalekit MCP：环境 URL 后接 /resources/ 与当前 MCP 的资源 ID。
# 必须先启用 Resource bound issuer（旧工作区）；不接受环境级 issuer 回退。
OAUTH_ISSUER_URL=https://your-environment.scalekit.com/resources/res_your_resource_id
OAUTH_JWKS_URL=https://your-environment.scalekit.com/keys
# Scalekit Dashboard > MCP Servers 中的 Resource ID，不是 OAuth Client ID。
# 其他提供方可省略本变量，默认验证 MCP_RESOURCE_URL。
OAUTH_AUDIENCE=res_your_resource_id
# OAuth 用户的稳定 sub 标识，多个值用逗号分隔
OAUTH_ALLOWED_SUBJECTS=
