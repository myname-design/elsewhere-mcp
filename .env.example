# 必填：Windy Webcams API key，申请地址 https://api.windy.com/keys
WINDY_API_KEY=

# 可选：show 工具把截图传到一个公开 GitHub 仓库，返回 jsDelivr 图片链接
# fine-grained token，只选这一个仓库，Contents 读写
GH_TOKEN=
GH_REPO=yourname/your-snaps

# 可选：Movebank 动物追踪。用户名和密码都要 base64 编码：printf %s '你的用户名' | base64
MOVEBANK_USER_B64=
MOVEBANK_PASS_B64=

# 可选：监听地址，默认 0.0.0.0:8787
HOST=0.0.0.0
PORT=8787


# HTTP 必填；本地 TRANSPORT=stdio 不需要这些 OAuth 配置
TRANSPORT=streamable-http
MCP_RESOURCE_URL=https://your-service.onrender.com/mcp
OAUTH_ISSUER_URL=https://your-identity-provider.example/
OAUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# OAuth 用户的稳定 sub 标识，多个值用逗号分隔
OAUTH_ALLOWED_SUBJECTS=
